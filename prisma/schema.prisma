  approvalScopeDigest    String                 @db.VarChar(71)
  issuance               Json
  plan                   Json
  fileActionSet          Json
  fileActionSetDigest    String                 @db.VarChar(71)
  replacementFiles       Json
  replacementFilesDigest String                 @db.VarChar(71)
  action                 String                 @default("READY_PR_ONLY") @db.VarChar(32)
  state                  String                 @default("ACTIVE") @db.VarChar(32)
  requestId              String                 @unique(map: "cp_fleet_cleanup_capability_request_key") @db.VarChar(191)
  requestDigest          String                 @db.VarChar(71)
  approvedBy             String                 @db.VarChar(128)
  approvedAt             DateTime               @db.DateTime(3)
  expiresAt              DateTime               @db.DateTime(3)
  consumedAt             DateTime?              @db.DateTime(3)
  createdAt              DateTime               @default(now()) @db.DateTime(3)
  execution              FleetCleanupExecution?

  @@index([authorityId, approvalScopeDigest, issueNumber], map: "cp_fleet_cleanup_capability_scope_idx")
  @@index([state, expiresAt], map: "cp_fleet_cleanup_capability_state_expiry")
  @@map("control_plane_fleet_cleanup_capability")
}


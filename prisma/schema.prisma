// Seorilabs Backoffice — v1 데이터 모델
// 원칙: GitHub = source of truth. 이 DB는 미러 + 라이프사이클 오케스트레이션 + 기획 인테이크 저장 계층.
// 검증 반영: WorkflowRunMirror 추가, Release 는 tag push + workflow_run 파생, v2 모델은 미생성.

generator client {
  provider = "prisma-client-js"
  // ARM64 런타임(bookworm-slim, openssl 3.x) 필수. 빌드 호스트와 별개로 명시.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// App — 앱/게임 중앙 레지스트리
// ──────────────────────────────────────────────────────────────────────────
model App {
  id           String    @id @default(cuid())
  slug         String    @unique // repo name, e.g. "happy-farm"
  displayName  String
  repoFullName String    @unique // "seorilabs/happy-farm"
  repoId       BigInt?   @unique // GitHub repo numeric id (rename 안전 키)
  type         AppType
  engine       AppEngine
  status       AppStatus @default(ACTIVE)
  currentStage Lifecycle @default(PLANNING)
  isPublicRepo Boolean   @default(false)

  // 마켓 식별자 (미설정/example-only 이면 null + UI "확정 필요" 뱃지)
  firebaseProject String?
  // GA4 BigQuery export 데이터셋("analytics_<propertyId>"). 지표 수집 대상 판별용.
  ga4Dataset      String?
  // Platform 운영 이벤트 수집 이전에 이미 만들어져 있던 Platform 계정 수.
  // 알림의 누적 순번은 이 값에 관측 이벤트 수를 더해 계산한다.
  platformUserBaseline Int?
  playPackage     String? @unique
  iosBundle       String?
  appleTeamId     String?
  iosSku          String?
  aitAppName      String?
  // AppsInToss 콘솔 지표 수집 매핑. 워크스페이스는 단일(38345)이나 명시 저장, miniAppId 는 앱당 유일.
  aitWorkspaceId  Int?
  aitMiniAppId    Int?    @unique

  marketTargets Json // ["play","appstore","ait","web"]

  // 부트스트랩 멱등
  configHash     String?
  configSyncedAt DateTime?
  // 게임 저장소의 .seorilabs/backoffice.json 선언형 관리툴 계약.
  // 실행 코드는 저장하지 않으며, invalid manifest는 error만 보존해 앱 워크스페이스에서 노출한다.
  opsManifest      Json?
  opsManifestError String? @db.Text

  // GitHub Projects v2 연결(읽기용)
  projectV2Id String?

  owners       AppOwner[]
  transitions  StageTransition[]
  issues       IssueMirror[]
  pullRequests PullRequestMirror[]
  workflowRuns WorkflowRunMirror[]
  releases     ReleaseRecord[]
  releaseNotes ReleaseNote[]
  operationRuns AppOperationRun[]
  operatorCommandRuns OperatorCommandRun[]
  incidents     OperationalIncident[]
  milestones    OperationalMilestone[]
  storeReviewSyncs StoreReviewSync[]
  storeReviewObservations StoreReviewObservation[]
  aiDrafts     AiDraft[]
  metrics      AppMetricDaily[]
  // 범용(스펙 구동) 컨텐츠 세부 지표 — 모든 게임 공용(lucid-chess/happy-farm/foam/crossword).
  contentMetrics AppContentMetricDaily[]
  // AppsInToss 콘솔 일별 지표(토스 표면 DAU/세션/잔존/IAA·IAP). GA4 와 별개 소스.
  consoleMetrics AppConsoleMetricDaily[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentStage])
  @@index([type, engine])
  @@map("app")
}

enum AppType {
  APP
  GAME
}

enum AppEngine {
  RN
  GODOT
}

enum AppStatus {
  ACTIVE
  PAUSED
  DEPRECATED
}

enum Lifecycle {
  PLANNING
  DEVELOPMENT
  QA
  MARKET_SUBMISSION
  RELEASE
  LIVEOPS
}

// ──────────────────────────────────────────────────────────────────────────
// StageTransition — 라이프사이클 이력/감사
// ──────────────────────────────────────────────────────────────────────────
model StageTransition {
  id         String           @id @default(cuid())
  appId      String
  app        App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  fromStage  Lifecycle? // 최초 진입은 null
  toStage    Lifecycle
  source     TransitionSource
  actorLogin String? // 수동 전이 시 github login
  reason     String?          @db.Text
  signalRef  String? // "workflow_run:123456", "manual"
  createdAt  DateTime         @default(now())

  @@index([appId, createdAt])
  @@map("stage_transition")
}

enum TransitionSource {
  BACKOFFICE
  GITHUB
  SYSTEM
}

// ──────────────────────────────────────────────────────────────────────────
// IssueMirror — GitHub 이슈 미러 (SoT=GitHub)
// ──────────────────────────────────────────────────────────────────────────
model IssueMirror {
  id           String       @id @default(cuid())
  appId        String?
  app          App?         @relation(fields: [appId], references: [id])
  repoFullName String
  number       Int
  nodeId       String       @unique // 멱등 upsert 키
  title        String       @db.Text
  state        IssueState
  stateReason  String? // completed | not_planned | reopened
  authorLogin  String?
  assignees    Json // ["magicsih"]
  labels       Json // ["P1","approval:planning","autopilot"]
  milestone    String?
  priority     Priority? // 라벨 파생(미러 시 앱이 채움)
  isAutopilot  Boolean      @default(false)
  hasEvidence  Boolean      @default(false)
  isBlocked    Boolean      @default(false)
  source       MirrorSource @default(UNKNOWN)
  clientReqId  String?      @unique // 백오피스 생성 멱등 마커
  linkedPrUrl  String?
  ghCreatedAt  DateTime     @db.DateTime(3)
  ghUpdatedAt  DateTime     @db.DateTime(3)
  mirroredAt   DateTime     @updatedAt

  @@unique([repoFullName, number])
  @@index([appId, state])
  @@index([state, priority])
  @@map("issue_mirror")
}

enum IssueState {
  OPEN
  CLOSED
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum MirrorSource {
  BACKOFFICE
  CLAUDE_CODE
  ROUTINE
  UNKNOWN
}

// ──────────────────────────────────────────────────────────────────────────
// PullRequestMirror
// ──────────────────────────────────────────────────────────────────────────
model PullRequestMirror {
  id            String   @id @default(cuid())
  appId         String?
  app           App?     @relation(fields: [appId], references: [id])
  repoFullName  String
  number        Int
  nodeId        String   @unique
  title         String   @db.Text
  state         PrState
  isDraft       Boolean  @default(false)
  authorLogin   String?
  headRef       String?
  baseRef       String?
  labels        Json
  linkedIssue   Int?
  isAutopilotPr Boolean  @default(false)
  mergedAt      DateTime? @db.DateTime(3)
  ghCreatedAt   DateTime @db.DateTime(3)
  ghUpdatedAt   DateTime @db.DateTime(3)
  mirroredAt    DateTime @updatedAt

  @@unique([repoFullName, number])
  @@index([appId, state])
  @@map("pull_request_mirror")
}

enum PrState {
  OPEN
  CLOSED
  MERGED
}

// ──────────────────────────────────────────────────────────────────────────
// WorkflowRunMirror — deploy-* 등 워크플로 실행 (출시 신호의 원천)
// ──────────────────────────────────────────────────────────────────────────
model WorkflowRunMirror {
  id           String   @id @default(cuid())
  appId        String?
  app          App?     @relation(fields: [appId], references: [id])
  repoFullName String
  runId        BigInt   @unique
  name         String? // "Deploy AppsInToss"
  status       String // queued | in_progress | completed
  conclusion   String? // success | failure | cancelled | ...
  event        String? // push | workflow_dispatch
  headSha      String?
  headBranch   String? // refs/tags/v1.2.3 도 가능
  runAttempt   Int      @default(1)
  runStartedAt DateTime? @db.DateTime(3)
  ghUpdatedAt  DateTime @db.DateTime(3)
  mirroredAt   DateTime @updatedAt

  @@index([appId, name])
  @@map("workflow_run_mirror")
}

// ──────────────────────────────────────────────────────────────────────────
// ReleaseRecord — tag push + workflow_run 에서 파생 (GitHub Release 객체 없음)
// ──────────────────────────────────────────────────────────────────────────
model ReleaseRecord {
  id            String        @id @default(cuid())
  appId         String
  app           App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  version       String // "v1.3.2"
  market        ReleaseMarket
  track         String?
  status        ReleaseStatus @default(PENDING)
  workflowRunId BigInt?
  workflowName  String?
  // GitHub workflow_run 이 아닌 외부 배포 실행(Xcode Cloud) 식별자.
  externalRunId String? @unique
  externalBuildNumber Int?
  commitSha     String?
  triggeredBy   String?
  startedAt     DateTime? @db.DateTime(3)
  deployedAt    DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([market, workflowRunId])
  @@index([appId, market, deployedAt])
  @@map("release_record")
}

// 알림 원본과 Discord 목적지별 배달 상태. 과거 provider 값은 이력 보존을 위해 유지한다.
model NotificationEvent {
  id         String               @id @default(cuid())
  dedupeKey  String               @unique
  kind       NotificationKind
  payload    Json
  occurredAt DateTime             @default(now()) @db.DateTime(3)
  createdAt  DateTime             @default(now())
  deliveries NotificationDelivery[]

  @@index([kind, occurredAt])
  @@map("notification_event")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  eventId        String
  event          NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider       NotificationProvider
  destinationKey String
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now()) @db.DateTime(3)
  lastError      String?                    @db.Text
  providerMessageId String?
  sentAt         DateTime?                  @db.DateTime(3)
  deletedAt      DateTime?                  @db.DateTime(3)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([eventId, provider, destinationKey])
  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

enum NotificationKind {
  DEPLOY_COMPLETION
  DAILY_METRICS
  OPERATIONS_SUMMARY
  OPERATIONAL_EVENT
  OPS_ALERT
  EXTERNAL_FEED
  MILESTONE
  INCIDENT
  STORE_REVIEW
  IDENTITY_SUMMARY
  IDENTITY_ROW
}

enum NotificationProvider {
  DISCORD
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

// Platform의 확정 도메인 이벤트 수신 원장. 사용자 식별자·토큰·영수증은 저장하지 않고
// eventId로 멱등 처리한 뒤 Discord 표시와 야간 집계에 사용한다.
model OperationalEvent {
  eventId    String   @id
  eventType  String
  appId      String
  occurredAt DateTime @db.DateTime(3)
  outcome    String
  attributes Json?
  receivedAt DateTime @default(now()) @db.DateTime(3)

  @@index([occurredAt])
  @@index([appId, eventType, occurredAt])
  @@map("operational_event")
}

// Discord 운영 명령 실행 원장. interaction id를 멱등 키로 삼고, 외부 쓰기는
// 별도 worker가 처리한다. interaction token은 저장하지 않는다.
model OperatorCommandRun {
  id                 String               @id @default(cuid())
  sourceInteractionId String              @unique
  appId              String?
  app                App?                 @relation(fields: [appId], references: [id], onDelete: SetNull)
  operation          String
  params             Json?
  actorDiscordUserId String
  actorLabel         String
  channelId          String
  messageId          String?
  status             OperatorCommandStatus @default(AWAITING_CONFIRMATION)
  attempts           Int                  @default(0)
  summary            String?              @db.Text
  error              String?              @db.Text
  confirmedAt        DateTime?             @db.DateTime(3)
  startedAt          DateTime?             @db.DateTime(3)
  completedAt        DateTime?             @db.DateTime(3)
  expiresAt          DateTime               @db.DateTime(3)
  redactedAt         DateTime?              @db.DateTime(3)
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([redactedAt, expiresAt])
  @@map("operator_command_run")
}

enum OperatorCommandStatus {
  AWAITING_CONFIRMATION
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

model OperationalIncident {
  id                    String             @id @default(cuid())
  dedupeKey             String             @unique
  appId                 String?
  app                   App?               @relation(fields: [appId], references: [id], onDelete: SetNull)
  source                String
  kind                  String
  severity              String
  status                IncidentStatus     @default(OPEN)
  summary               String             @db.Text
  evidence              Json?
  destinationKey        String             @default("ops-alerts")
  providerMessageId     String?
  acknowledgedBy        String?
  acknowledgedAt        DateTime?          @db.DateTime(3)
  assignedDiscordUserId String?
  firstDetectedAt       DateTime            @db.DateTime(3)
  lastDetectedAt        DateTime            @db.DateTime(3)
  recoveredAt           DateTime?           @db.DateTime(3)
  createdAt             DateTime            @default(now()) @db.DateTime(3)
  updatedAt             DateTime            @updatedAt

  @@index([status, severity, lastDetectedAt])
  @@index([appId, status])
  @@map("operational_incident")
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RECOVERED
}

model OperationalMilestone {
  id             String   @id @default(cuid())
  appId          String
  app            App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  eventType      String
  firstEventId   String
  firstObservedAt DateTime @db.DateTime(3)
  notifiedAt     DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)

  @@unique([appId, eventType])
  @@map("operational_milestone")
}

// 마켓 리뷰 수집 기준선. 앱·마켓별 첫 성공 수집은 과거 리뷰를 알리지 않고
// 기준선으로만 저장한다. 이후 수집부터 신규·변경 리뷰만 outbox에 넣는다.
model StoreReviewSync {
  id               String           @id @default(cuid())
  appId            String
  app              App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  store            StoreReviewStore
  initializedAt    DateTime         @default(now()) @db.DateTime(3)
  lastSuccessfulAt DateTime         @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt

  @@unique([appId, store])
  @@index([store, lastSuccessfulAt])
  @@map("store_review_sync")
}

// 관찰 테이블에는 리뷰 원문이나 작성자명을 저장하지 않는다. 표시 내용의 hash와
// 별점만 보존한다. 전송용 outbox 원문은 Discord 보존기한 뒤 별도로 제거한다.
model StoreReviewObservation {
  id               String           @id @default(cuid())
  appId            String
  app              App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  store            StoreReviewStore
  externalReviewId String
  rating           Int
  contentHash      String
  notifiedHash     String?
  sourceCreatedAt  DateTime?        @db.DateTime(3)
  sourceModifiedAt DateTime?        @db.DateTime(3)
  firstObservedAt  DateTime         @default(now()) @db.DateTime(3)
  lastObservedAt   DateTime         @default(now()) @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt

  @@unique([appId, store, externalReviewId])
  @@index([appId, store, sourceModifiedAt])
  @@map("store_review_observation")
}

enum StoreReviewStore {
  GOOGLE_PLAY
  APP_STORE
}

// 앱 운영 요청 큐. 백오피스 API는 검증된 요청만 적재하고, 별도 Kubernetes worker가
// 게임별 최소권한 identity로 처리한다. params/result는 단기 보관 후 worker가 제거한다.
model AppOperationRun {
  id           String                @id @default(cuid())
  requestId    String                @unique
  appId        String
  app          App                   @relation(fields: [appId], references: [id], onDelete: Cascade)
  repoFullName String
  operation    String
  intent       String
  params       Json?
  reason       String?               @db.Text
  actorLogin   String?
  status       AppOperationRunStatus @default(PENDING)
  attempts     Int                   @default(0)
  summary      String?               @db.Text
  result       Json?
  error        String?               @db.Text
  startedAt    DateTime?             @db.DateTime(3)
  completedAt  DateTime?             @db.DateTime(3)
  expiresAt    DateTime              @db.DateTime(3)
  redactedAt   DateTime?             @db.DateTime(3)
  createdAt    DateTime              @default(now()) @db.DateTime(3)
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([appId, createdAt])
  @@index([redactedAt, expiresAt])
  @@map("app_operation_run")
}

enum AppOperationRunStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// 출시노트 — 릴리즈 태그(이전 태그~새 태그 diff) 기반 다국어 유저용 공지.
// 마켓 무관, 버전(태그)당 1건. webhook(tag push) 또는 수동 백필로 생성.
model ReleaseNote {
  id              String            @id @default(cuid())
  appId           String
  app             App               @relation(fields: [appId], references: [id], onDelete: Cascade)
  repoFullName    String
  version         String // 태그, e.g. "v1.3.0"
  previousVersion String? // 직전 릴리즈 태그
  headSha         String?
  compareUrl      String? // GitHub compare 링크
  koKR            String            @db.Text // 한국어 유저용 출시노트
  enUS            String            @db.Text // 영어 유저용 출시노트
  jaJP            String?           @db.Text // 일본어 유저용 출시노트
  zhCN            String?           @db.Text // 중국어 간체 유저용 출시노트
  zhTW            String?           @db.Text // 중국어 번체 유저용 출시노트
  deDE            String?           @db.Text // 독일어 유저용 출시노트
  frFR            String?           @db.Text // 프랑스어 유저용 출시노트
  esES            String?           @db.Text // 스페인어 유저용 출시노트
  sourceJson      Json? // 생성 근거(커밋/PR 요약)
  status          ReleaseNoteStatus @default(GENERATED)
  model           String? // 생성 모델
  createdAt       DateTime          @default(now())

  @@unique([repoFullName, version])
  @@index([appId, createdAt])
  @@map("release_note")
}

enum ReleaseNoteStatus {
  GENERATED
  FAILED
}

enum ReleaseMarket {
  PLAY
  APPSTORE
  AIT
  WEB
}

enum ReleaseStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

// ──────────────────────────────────────────────────────────────────────────
// User / AppOwner — 인증 + allowlist
// ──────────────────────────────────────────────────────────────────────────
model User {
  id          String     @id @default(cuid())
  githubId    BigInt     @unique
  login       String     @unique
  name        String?
  avatarUrl   String?
  role        UserRole   @default(VIEWER)
  allowlisted Boolean    @default(false)
  lastLoginAt DateTime?
  ownedApps   AppOwner[]
  createdAt   DateTime   @default(now())

  @@map("app_user") // "user" 예약어 회피
}

enum UserRole {
  ADMIN
  MAINTAINER
  VIEWER
}

model AppOwner {
  appId  String
  userId String
  role   OwnerRole @default(OWNER)
  app    App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([appId, userId])
  @@map("app_owner")
}

enum OwnerRole {
  OWNER
  CONTRIBUTOR
}

// ──────────────────────────────────────────────────────────────────────────
// AiDraft — Stage Agent(Gemini) 산출 초안. 초안→검토→1클릭 커밋.
// AI 는 GitHub 에 직접 쓰지 않음: 이 테이블이 검토 큐 + 감사 + 재생성 근거.
// ──────────────────────────────────────────────────────────────────────────
model AiDraft {
  id           String        @id @default(cuid())
  appId        String
  app          App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  repoFullName String
  stage        Lifecycle // 어느 단계 에이전트 산출인가
  kind         AiDraftKind
  title        String?       @db.Text // 커밋(새 이슈) 시 제목
  issueNumber  Int? // 코멘트 커밋 대상(분해 등). 새 이슈형은 null
  inputJson    Json // 생성 입력 컨텍스트(재생성/감사)
  outputText   String        @db.Text // LLM 산출(사람이 수정 가능)
  model        String // "gemini-3.1-flash-lite"
  status       AiDraftStatus @default(DRAFT)
  committedIssueNumber Int? // 커밋 결과 이슈 번호
  committedUrl String?
  committedAt  DateTime?     @db.DateTime(3)
  createdBy    String? // github login
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([appId, stage, status])
  @@index([status, createdAt])
  @@map("ai_draft")
}

enum AiDraftKind {
  PLANNING_SPEC
  TASK_BREAKDOWN
  QA_CHECKLIST
  STORE_COPY
  IMPROVEMENT_HYPOTHESIS
  RELEASE_NOTES
  BUG_REPORT
}

enum AiDraftStatus {
  DRAFT
  COMMITTED
  DISCARDED
}

// ──────────────────────────────────────────────────────────────────────────
// AppMetricDaily — GA4→BigQuery 일별 지표 스냅샷
// 수집 CronJob(21:00 KST)이 BigQuery 를 쿼리해 앱×날짜 단위로 upsert 한다.
// 대시보드/야간 보고서는 BigQuery 를 직접 치지 않고 이 스냅샷만 읽는다(속도/비용).
// GA4 export 지연 → date 는 D-1 확정 기준, 최근 N일을 매일 재집계(멱등 upsert).
// D1/D3/D7 은 "그 날 신규 코호트"의 잔존율이라 확정까지 최대 7일 → 재집계로 채워짐.
// ──────────────────────────────────────────────────────────────────────────
model AppMetricDaily {
  id    String   @id @default(cuid())
  appId String
  app   App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  date  DateTime @db.Date // 지표 기준일(YYYY-MM-DD, 앱 GA4 타임존)

  dau           Int    @default(0)
  newUsers      Int    @default(0) // first_visit
  returnRatePct Float? // 전체 재방문율(코호트 n>=1)
  d1Pct         Float? // 그 날 신규 코호트의 D1 잔존율
  d3Pct         Float?
  d7Pct         Float?
  engagedUsers  Int    @default(0)
  avgEngageSec  Float? // user_engagement 평균 초
  adEventUsers  Int    @default(0) // legacy 광의 광고 이벤트 고유 사용자
  adImpressions Int    @default(0) // legacy 광의 광고 이벤트 수 — 노출로 표시하지 않음
  adCtaUsers Int @default(0) // ad_reward_impression 고유 사용자
  adCtaImpressions Int @default(0) // 광고 CTA 지면 노출
  adCompletedUsers Int @default(0) // ad_reward_completed 고유 사용자
  adCompletions Int @default(0) // 보상형 광고 완료
  networkAdUsers Int @default(0) // 표준 ad_impression 고유 사용자
  networkAdImpressions Int    @default(0) // SDK/네트워크 실제 광고 노출
  dauAndroid    Int    @default(0) // platform=ANDROID DAU
  dauIos        Int    @default(0) // platform=IOS DAU
  dauWeb        Int    @default(0) // platform=WEB DAU
  raw           Json? // 차원 분해(국가/기기/OS top-N) 등 부가 지표 원본 — MetricBreakdowns

  collectedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([appId, date])
  @@index([date])
  @@map("app_metric_daily")
}

// ──────────────────────────────────────────────────────────────────────────
// AppContentMetricDaily — 앱 컨텐츠 세부 지표 일별 스냅샷(공통 지표 AppMetricDaily 와 분리)
// 모든 게임의 컨텐츠 이벤트(체스 결과분포/난이도, 농장 작물/구역/퍼널, 폼파티 레벨/수익화/
// 미션/경제, 크로스워드 완료퍼널/난이도 등)를 GA4→BigQuery 에서 스펙(content-registry) 기준으로
// 집계해 (앱×날짜×마켓)로 upsert 한다. 지표 구성은 앱마다 다르므로(pluggable 스펙) 고정 컬럼
// 대신 raw JSON(ContentMetricSnapshot: metrics/distributions/groups)에 담는다. 하루 딜레이 허용,
// 멱등 재집계. 향후 자체 지표 서버로 소스만 교체(ContentMetricsSource 포트) — 스키마는 불변.
//
// market: 마켓 미선언 스펙은 'all' 단일 행. 마켓 선언 스펙(foam=android/ios/web,
// crossword=apps-in-toss/google-play/app-store)은 마켓별 + 통합('all') 행을 각각 저장해,
// 한 조회로 통합/개별을 모두 낸다.
// ──────────────────────────────────────────────────────────────────────────
model AppContentMetricDaily {
  id     String   @id @default(cuid())
  appId  String
  app    App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // 지표 기준일(YYYY-MM-DD)
  market String   @default("all") // 'all'(통합) 또는 마켓 key

  totalEvents Int  @default(0) // 그 날 스펙 이벤트 총 발생 수(수집 유효성/정렬용)
  raw         Json // 컨텐츠 지표 스냅샷 — ContentMetricSnapshot(지표/분포/그룹)

  collectedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([appId, date, market])
  @@index([date])
  @@map("app_content_metric_daily")
}

// ──────────────────────────────────────────────────────────────────────────
// AppConsoleMetricDaily — AppsInToss 콘솔 일별 지표 스냅샷(GA4 와 별개 소스)
// 토스 표면 전용 데이터: 콘솔 기준 DAU/신규, 평균 세션, IAA(광고)·IAP(인앱결제) 매출,
// 유입경로(전체탭/미니앱홈)·연령/성별/OS·잔존 코호트 등. 콘솔 MCP 는 사용자 OAuth 세션이라
// pod 가 직접 pull 불가 → 인증된 로컬 Claude 세션이 MCP 로 조회해 ingest route 로 push 한다.
// GA4 수집과 동일하게 앱×날짜 upsert, 최근 N일 재집계(멱등). 향후 서비스 자격증명이 생기면
// pod-side pull(ConsoleMetricsSource) 로 무중단 교체 — 스키마 불변.
// 승격 컬럼은 '일별 스칼라'만, 나머지(잔존 코호트/데모그래픽/OS별 분해)는 raw JSON.
// ──────────────────────────────────────────────────────────────────────────
model AppConsoleMetricDaily {
  id    String   @id @default(cuid())
  appId String
  app   App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  // 콘솔 미니앱 리스팅 id. 한 App(=repo)이 콘솔에 여러 미니앱으로 등록될 수 있어(예:
  // crossword-puzzle 웹 36555 + 네이티브 게임 56407) 지표는 (appId, miniAppId, date)로 분리한다.
  miniAppId Int
  date      DateTime @db.Date // 지표 기준일(YYYY-MM-DD, 토스/KST)

  // dau/newUsers 는 nullable: 콘솔 DAU endpoint 는 세션/광고 활동이 있어도 식별 불가 세션을
  // 집계에서 누락(키 자체 부재)한다. 이 경우 0(=방문 0명)이 아니라 null(=콘솔 미집계)로 저장해
  // 세션/광고 수익은 보존하되 허수 0 을 만들지 않는다.
  dau              Int? // 콘솔 활성 사용자(au). null=콘솔 미집계
  newUsers         Int? // 신규 활성(newAu). null=콘솔 미집계
  avgSessionSec    Float? // 평균 세션 길이(초)
  iaaImpressions   Int    @default(0) // 광고 노출(OS 합)
  iaaEarningKrw    Float  @default(0) // 광고 추정 수익(원, OS 합)
  iapTrxAmountKrw  Float  @default(0) // 인앱결제 거래액(원)
  iapSettlementKrw Float  @default(0) // 인앱결제 정산액(원)
  payingUsers      Int    @default(0) // 결제 사용자(pu)
  raw              Json? // 부가 원본: 유입경로/데모그래픽/OS별 IAA/잔존 코호트/앱버전 등

  collectedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([appId, miniAppId, date])
  @@index([date])
  @@map("app_console_metric_daily")
}

// ──────────────────────────────────────────────────────────────────────────
// 인프라 테이블
// ──────────────────────────────────────────────────────────────────────────
// Discord /ask 대화 문맥. 서버·채널·사용자 조합별로 분리한다.
// teammate 는 AI 팀원 봇의 대화를 메인 봇 /ask 와 격리한다(null = 메인 봇).
model DiscordTurn {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  userId    String
  teammate  String?
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([guildId, channelId, userId, teammate, createdAt])
  @@map("discord_turn")
}

// AI 팀원 실행 원장. 멘션 응답과 순찰 실행을 모두 기록하고, dedupeKey unique 가
// Gateway resume 중복 응답과 순찰 중복 트리거를 DB 수준에서 막는다.
// 순찰(trigger=schedule)은 PENDING 으로 삽입되고 teammate worker 가 큐처럼 소화한다.
model TeammateRun {
  id           String            @id @default(cuid())
  teammate     String
  trigger      String
  dedupeKey    String            @unique
  scope        String?           @db.Text
  status       TeammateRunStatus @default(PENDING)
  findingCount Int               @default(0)
  findings     Json?
  issueUrls    Json?
  outcome      String?           @db.Text
  attempts     Int               @default(0)
  startedAt    DateTime?         @db.DateTime(3)
  completedAt  DateTime?         @db.DateTime(3)
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  updatedAt    DateTime          @updatedAt

  @@index([teammate, createdAt])
  @@index([status, createdAt])
  @@map("teammate_run")
}

enum TeammateRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WebhookDelivery {
  deliveryId String   @id // X-GitHub-Delivery
  event      String
  action     String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("webhook_delivery")
}

model SyncCursor {
  repoFullName String   @id
  lastIssueSync    DateTime?
  lastPrSync       DateTime?
  lastRunSync      DateTime?
  updatedAt        DateTime @updatedAt

  @@map("sync_cursor")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorLogin String? // null = system/webhook
  action     String // "app.create", "stage.transition", "webhook.received"
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ──────────────────────────────────────────────────────────────────────────
// Vault RAG — Obsidian 지식 볼트(Syncthing) 임베딩 인덱스 + 쓰기 큐
// indexer(data ns)가 PVC 를 읽어 채우고, backoffice(platform ns)는 MySQL 로만 조회.
// 벡터는 ANN 인덱스(HeatWave 전용) 없이 float32 BLOB 로 저장 → 앱에서 brute-force cosine.
// ──────────────────────────────────────────────────────────────────────────
model VaultChunk {
  id        String   @id @default(cuid())
  path      String // 볼트 기준 상대경로, e.g. "프로젝트/앱 제작 공장/11 백오피스.md"
  ord       Int // 파일 내 청크 순서
  heading   String?  @db.Text // 가장 가까운 헤딩 breadcrumb
  text      String   @db.Text
  fileHash  String // 파일 전체 sha256 (증분 인덱싱 판정)
  embedding Bytes // float32 LE 패킹
  dim       Int
  chars     Int      @default(0)
  indexedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([path, ord])
  @@index([fileHash])
  @@index([indexedAt])
  @@map("vault_chunk")
}

model VaultWriteRequest {
  id          String           @id @default(cuid())
  folder      String           @default("받은함") // 대상 하위폴더(allowlist 강제)
  filename    String // 확장자 제외 제목(슬러그화)
  content     String           @db.Text
  source      String           @default("agent") // agent|discord|web
  requestedBy String?
  status      VaultWriteStatus @default(PENDING)
  writtenPath String? // 실제 기록된 상대경로
  error       String?          @db.Text
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  processedAt DateTime?        @db.DateTime(3)

  @@index([status])
  @@map("vault_write_request")
}

enum VaultWriteStatus {
  PENDING
  DONE
  FAILED
}

/// 플랫폼 전체 사용자 규모의 시점 스냅샷.
///
/// 앱별 지표(AppMetricDaily)와 달리 앱을 가로지르는 플랫폼 전체 값이라
/// appId가 없다. 매시 정각에 platform Admin API를 찍어 저장한다.
///
/// 백필이 불가능하다. platform의 lastSeenAt은 덮어쓰기라 과거 시점의
/// 활성 사용자 수를 복원할 수 없다. 이 표는 수집을 시작한 시점부터만
/// 존재하고, cron이 실패한 구간은 영구히 빈다.
model PlatformUserMetricSample {
  id String @id @default(cuid())

  /// 서버가 집계 기준으로 삼은 시각을 정시로 내림한 값.
  /// 재실행해도 같은 시각이면 덮어쓰도록 유니크로 둔다.
  capturedAt DateTime @unique @db.DateTime(3)

  totalUsers        Int @default(0)
  /// 직전 1시간 활성. 창이 겹치지 않아 시간대별 굴곡이 남는다.
  hourlyActiveUsers Int @default(0)
  /// 직전 24시간 롤링. 이웃한 시간 샘플과 창을 23/24 공유한다.
  dailyActiveUsers  Int @default(0)
  weeklyActiveUsers Int @default(0)

  /// 활성 판정 근거. platform이 정의를 바꾸면 여기서 드러나야 한다.
  activitySource String @default("session_last_seen")

  collectedAt DateTime @default(now()) @db.DateTime(3)

  @@index([capturedAt])
  @@map("platform_user_metric_sample")
}

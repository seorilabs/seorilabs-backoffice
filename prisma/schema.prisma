model FleetCleanupCapability {
  id                     String                 @id @default(cuid())
  authorityId            String
  authority              FleetCleanupAuthority  @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cp_fleet_cleanup_capability_authority_fkey")

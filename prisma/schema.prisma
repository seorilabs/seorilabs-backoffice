// repository webhook의 등록 원장. stack 후보가 하나로 확정되기 전에는 App을 추측 생성하지 않는다.
model RepositoryRegistration {
  repoId                        BigInt                             @id
  repoFullName                  String                             @unique
  defaultBranch                 String?
  archived                      Boolean                            @default(false)
  fork                          Boolean?
  status                        RepositoryRegistrationStatus       @default(REGISTERED)
  managementKind                RepositoryManagementKind?
  // managementKind의 legacy APP 값을 즉시 재해석하지 않도록 둔 additive v2 분류 정본.
  // discovery terminal fact 또는 append-only explicit decision이 쓰며 source/build 미준비가 값을 지우지 않는다.
  classification                RepositoryClassification?
  discoveryContractVersion      String?                            @db.VarChar(64)
  classificationDecisionVersion Int?                               @default(0)
  discoveryCandidates           Json?
  lastDefaultPushSha            String?                            @db.Char(40)
  reconcileGeneration           Int?
  lastReconciledSha             String?                            @db.Char(40)
  lastDiscoveryReason           String?                            @db.VarChar(64)
  lastDeliveryId                String?
  discoveryRuns                 RepositoryDiscoveryRun[]
  classificationDecisions       RepositoryClassificationDecision[]
  createdAt                     DateTime                           @default(now()) @db.DateTime(3)
  updatedAt                     DateTime                           @updatedAt

  @@index([status, updatedAt])
  @@map("repository_registration")
}

enum RepositoryRegistrationStatus {
  REGISTERED
  NEEDS_INPUT
  MANAGED
  ARCHIVED
}

enum RepositoryManagementKind {
  UNCLASSIFIED
  APP
  PLATFORM_PRODUCER
}

enum RepositoryClassification {
  PRODUCT_APP
  INFRA_REPO
  PLATFORM_PRODUCER
  EXCLUDED
}

// NEEDS_INPUT 결정과 기존 MANAGED terminal 관측 ratification을 사람과 승인된 AI가
// 같은 계약으로 기록하는 append-only revision. 등록 row의 version과 함께 잠가
// optimistic concurrency를 강제하며 교정도 새 revision으로만 남긴다.
model RepositoryClassificationDecision {
  id                  String                   @id @default(cuid())
  repoId              BigInt
  registration        RepositoryRegistration   @relation(fields: [repoId], references: [repoId], onDelete: Cascade, onUpdate: Restrict)
  revision            Int
  classification      RepositoryClassification
  candidateMarkerPath String?                  @db.VarChar(512)
  // PRODUCT_APP의 중앙 desired identity. source/build observation이 아직 없는
  // planning 제품도 App에 등록하되, 이 값으로 build target을 합성하지 않는다.
  productDisplayName  String?                  @db.VarChar(191)
  productType         AppType?
  productEngine       AppEngine?
  justification       String                   @db.VarChar(64)
  requestHash         String                   @db.Char(64)
  idempotencyKey      String                   @unique
  createdBy           String                   @db.VarChar(128)
  createdAt           DateTime                 @default(now()) @db.DateTime(3)

  @@unique([repoId, revision])
  @@index([repoId, createdAt])
  @@map("repository_classification_decision")
}

// webhook 응답과 GitHub source read를 분리하는 durable 재조정 원장이다.
// leaseGeneration CAS로 사라진 worker의 늦은 완료가 최신 push를 덮지 못한다.
model RepositoryDiscoveryRun {
  id                String                       @id @default(cuid())
  repoId            BigInt
  registration      RepositoryRegistration       @relation(fields: [repoId], references: [repoId], onDelete: Cascade)
  generation        Int
  triggerDeliveryId String                       @unique
  requestHash       String                       @db.Char(64)
  sourceSha         String?                      @db.Char(40)
  sourceRef         String?
  status            RepositoryDiscoveryRunStatus @default(QUEUED)
  reasonCode        String?                      @db.VarChar(64)
  classification    RepositoryClassification?
  contractVersion   String?                      @db.VarChar(64)
  candidateDigest   String?                      @db.Char(64)
  observationId     String?                      @unique
  observation       DiscoveryObservation?        @relation(fields: [observationId], references: [id], onDelete: SetNull)
  attempts          Int                          @default(0)
  leaseGeneration   Int                          @default(0)
  workerId          String?
  leaseExpiresAt    DateTime?                    @db.DateTime(3)
  availableAt       DateTime                     @default(now()) @db.DateTime(3)
  startedAt         DateTime?                    @db.DateTime(3)
  completedAt       DateTime?                    @db.DateTime(3)
  createdAt         DateTime                     @default(now()) @db.DateTime(3)
  updatedAt         DateTime                     @updatedAt

  @@unique([repoId, generation])
  @@index([status, availableAt, createdAt])
  @@index([repoId, createdAt])
  @@map("repository_discovery_run")
}

enum DesiredStateBackfillRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
}

enum DesiredStateBackfillTrigger {
  HOURLY_CRON
  DEPLOY_CATCH_UP
  CONTROL_PLANE_API
}

// 중앙 desired-state DRAFT backfill occurrence. 요청 멱등과 UI readback만 보존하며
// provider/GitHub mutation 또는 secret material은 담지 않는다.
model DesiredStateBackfillRun {
  id              String                        @id @default(cuid())
  idempotencyKey  String                        @unique
  requestHash     String                        @db.Char(64)
  contractVersion String                        @db.VarChar(64)
  actor           String                        @db.VarChar(128)
  trigger         DesiredStateBackfillTrigger?
  sourceSha       String?                       @db.Char(40)
  status          DesiredStateBackfillRunStatus @default(RUNNING)
  summary         Json?
  startedAt       DateTime                      @default(now()) @db.DateTime(3)
  completedAt     DateTime?                     @db.DateTime(3)

  @@index([status, startedAt])
  @@index([trigger, sourceSha, startedAt], map: "cp_desired_backfill_trigger_source_started_idx")
  @@map("control_plane_desired_state_backfill_run")
}

enum RepositoryDiscoveryRunStatus {
  QUEUED
  RUNNING
  MANAGED
  NEEDS_INPUT
  EXCLUDED
  STALE
  FAILED
}

// durable automation queue. AgentRepoGuard가 lease TTL과 독립적으로 같은 repo의
// 자율 PR 권한을 한 run에 고정하고, AgentLease는 generation별 실행 capability만 가진다.
model AutomationDefinition {
  id            String                 @id @default(cuid())
  key           String                 @unique
  appId         String?
  app           App?                   @relation(fields: [appId], references: [id], onDelete: Cascade)
  template      String
  schedule      String?
  agentKind     String?
  model         String?
  configuration Json?
  enabled       Boolean                @default(true)
  pausedAt      DateTime?              @db.DateTime(3)
  cancelledAt   DateTime?              @db.DateTime(3)
  maxAttempts   Int                    @default(3)
  createdAt     DateTime               @default(now()) @db.DateTime(3)
  updatedAt     DateTime               @updatedAt
  occurrences   AutomationOccurrence[]

  @@index([enabled])
  @@map("automation_definition")
}

model AutomationOccurrence {
  id             String                     @id @default(cuid())
  definitionId   String
  definition     AutomationDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime                   @db.DateTime(3)
  idempotencyKey String                     @unique
  triggerKind    String?
  triggerKey     String?                    @unique
  status         AutomationOccurrenceStatus @default(PENDING)
  result         Json?
  createdAt      DateTime                   @default(now()) @db.DateTime(3)
  completedAt    DateTime?                  @db.DateTime(3)
  runs           AgentRun[]

  @@unique([definitionId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("automation_occurrence")
}

enum AutomationOccurrenceStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model AgentRun {
  id                  String               @id @default(cuid())
  occurrenceId        String
  occurrence          AutomationOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  appId               String?
  app                 App?                 @relation(fields: [appId], references: [id], onDelete: SetNull)
  repoFullName        String
  issueNumber         Int?
  workKey             String?              @unique
  issueState          String?
  labels              Json
  taskInput           Json?
  createsPr           Boolean              @default(true)
  priority            Int                  @default(100)
  status              AgentRunStatus       @default(PENDING)
  leaseGeneration     Int                  @default(0)
  attempts            Int                  @default(0)
  maxAttempts         Int                  @default(3)
  spentMicros         BigInt?
  eligibleAt          DateTime             @default(now()) @db.DateTime(3)
  startedAt           DateTime?            @db.DateTime(3)
  completedAt         DateTime?            @db.DateTime(3)
  outcome             Json?
  error               String?              @db.Text
  readbackRequestedAt DateTime?            @db.DateTime(3)
  cancelledAt         DateTime?            @db.DateTime(3)
  createdAt           DateTime             @default(now()) @db.DateTime(3)
  updatedAt           DateTime             @updatedAt
  leases              AgentLease[]
  events              AgentRunEvent[]
  reauthRequests      ReauthRequest[]
  repoGuard           AgentRepoGuard?
  platformFleetPlan   PlatformFleetPlan?

  @@index([status, eligibleAt, priority])
  @@index([repoFullName, status])
  @@map("agent_run")
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

// AgentLease TTL과 독립적으로 repo별 자율 PR 권한을 한 run에 고정한다.
// lease 만료·결과 불명 후에도 같은 run의 readback/retry가 끝날 때까지 유지한다.
model AgentRepoGuard {
  id             String    @id @default(cuid())
  runId          String    @unique
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  repoFullName   String
  activeScopeKey String?   @unique
  acquiredAt     DateTime  @default(now()) @db.DateTime(3)
  releasedAt     DateTime? @db.DateTime(3)

  @@index([repoFullName, releasedAt])
  @@map("agent_repo_guard")
}

model AgentLease {
  id            String              @id @default(cuid())
  runId         String
  run           AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  generation    Int
  // 서버 내부의 폐기 nonce hash다. 원문 capability는 생성 직후 버리고 worker 응답에 내보내지 않는다.
  tokenHash     String              @db.Char(64)
  workerId      String
  scopeKey      String?             @unique
  expiresAt     DateTime            @db.DateTime(3)
  heartbeatAt   DateTime            @db.DateTime(3)
  revokedAt     DateTime?           @db.DateTime(3)
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  workerSession AgentWorkerSession?

  @@unique([runId, generation])
  @@index([workerId, expiresAt])
  @@map("agent_lease")
}

// public sessionId는 credential이 아니며 worker bearer 대신 사용할 수 없다. 실제 권한은
// seori-auth helper의 workload identity와 이 immutable run binding을 함께 검증한다.
model AgentWorkerSession {
  id                   String                     @id @db.VarChar(64)
  leaseId              String                     @unique
  lease                AgentLease                 @relation(fields: [leaseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "agent_worker_session_lease_id_fkey")
  runId                String
  generation           Int
  principalId          String                     @db.VarChar(128)
  runtimeBindingDigest String                     @db.Char(64)
  repoId               BigInt
  repoFullName         String                     @db.VarChar(191)
  issueNumber          Int?
  sourceSha            String                     @db.Char(40)
  expiresAt            DateTime                   @db.DateTime(3)
  heartbeatAt          DateTime                   @db.DateTime(3)
  revokedAt            DateTime?                  @db.DateTime(3)
  settledAt            DateTime?                  @db.DateTime(3)
  createdAt            DateTime                   @default(now()) @db.DateTime(3)
  updatedAt            DateTime                   @updatedAt
  observations         AgentGithubObservation[]
  grants               AgentActionGrant[]
  mutationStepAttempts AgentMutationStepAttempt[]

  @@unique([runId, generation], map: "agent_worker_session_run_generation_key")
  @@index([principalId, expiresAt], map: "agent_worker_session_principal_expiry_idx")
  @@index([runtimeBindingDigest, expiresAt], map: "agent_worker_session_runtime_expiry_idx")
  @@index([repoId, sourceSha], map: "agent_worker_session_repo_source_idx")
  @@map("agent_worker_session")
}

// Trusted GitHub adapter가 complete pagination과 현재 repo/issue/PR 공개 상태를
// Ed25519 attestation으로 봉인한 observation이다.
model AgentGithubObservation {
  id                        String                  @id @default(cuid())
  sessionId                 String                  @db.VarChar(64)
  session                   AgentWorkerSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "agent_github_observation_session_id_fkey")
  phase                     String                  @db.VarChar(16)
  adapterPrincipalId        String                  @db.VarChar(128)
  adapterRuntimeIdentity    String                  @db.VarChar(191)
  githubInstallationId      String                  @db.VarChar(30)
  providerSnapshotId        String                  @db.VarChar(191)
  pageCount                 Int
  repoId                    BigInt
  repoFullName              String                  @db.VarChar(191)
  defaultBranchRef          String                  @db.VarChar(255)
  defaultBranchSha          String                  @db.Char(40)
  issueNumber               Int?
  issueNodeId               String?                 @db.VarChar(191)
  issueState                String?                 @db.VarChar(16)
  issueLabels               Json?
  issueUpdatedAt            DateTime?               @db.DateTime(3)
  openAutopilotPullRequests Json
  mutationTarget            Json?
  payloadDigest             String                  @db.Char(64)
  observedAt                DateTime                @db.DateTime(3)
  createdAt                 DateTime                @default(now()) @db.DateTime(3)
  grants                    AgentActionGrant[]
  readbacks                 AgentMutationReadback[]

  @@index([sessionId, phase, observedAt], map: "agent_github_observation_session_phase_idx")
  @@index([repoId, observedAt], map: "agent_github_observation_repo_observed_idx")
  @@map("agent_github_observation")
}

// Ed25519 route/body attestation nonce는 전 route에서 한 번만 소비한다. 만료 row는
// 새 attestation을 검증할 때 함께 정리해 무한 증가하지 않는다.
model AgentAdapterNonce {
  nonceDigest     String   @id @db.Char(64)
  route           String   @db.VarChar(191)
  bodyDigest      String   @db.Char(64)
  runtimeIdentity String   @db.VarChar(191)
  expiresAt       DateTime @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([expiresAt], map: "agent_adapter_nonce_expires_idx")
  @@map("agent_adapter_nonce")
}

// grant는 trusted adapter의 최신 observation 뒤에 발급되고 같은 transaction에서 즉시
// 소비된다. token 원문이나 token hash를 worker/API 계약에 만들지 않는다.
model AgentActionGrant {
  id                        String                  @id @default(cuid())
  sessionId                 String                  @db.VarChar(64)
  session                   AgentWorkerSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "agent_action_grant_session_id_fkey")
  observationId             String                  @unique(map: "agent_action_grant_observation_id_key")
  observation               AgentGithubObservation  @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_action_grant_observation_id_fkey")
  runId                     String
  generation                Int
  principalId               String                  @db.VarChar(128)
  adapterPrincipalId        String                  @db.VarChar(128)
  adapterRuntimeIdentity    String                  @db.VarChar(191)
  repoId                    BigInt
  repoFullName              String                  @db.VarChar(191)
  issueNumber               Int?
  sourceSha                 String                  @db.Char(40)
  action                    String                  @db.VarChar(64)
  mutationIntentDigest      String                  @db.Char(64)
  expectedHeadRef           String                  @db.VarChar(255)
  expectedPullRequestMarker String                  @db.VarChar(191)
  bindingDigest             String                  @db.Char(64)
  requestId                 String                  @unique(map: "agent_action_grant_request_id_key") @db.VarChar(191)
  expiresAt                 DateTime                @db.DateTime(3)
  consumedAt                DateTime                @db.DateTime(3)
  revokedAt                 DateTime?               @db.DateTime(3)
  createdAt                 DateTime                @default(now()) @db.DateTime(3)
  execution                 AgentMutationExecution?

  @@unique([runId, generation, action], map: "agent_action_grant_run_generation_action_key")
  @@index([repoFullName, expiresAt], map: "agent_action_grant_repo_expiry_idx")
  @@map("agent_action_grant")
}

// execution은 CREATE_COMMIT/CREATE_REF/CREATE_PR durable step ledger의 소유자다.
// worker settlement는 세 단계와 trusted adapter가 별도 attestation으로 기록한 최종 VERIFIED
// readback이 모두 일치할 때만 PR_READY 근거로 사용할 수 있다.
model AgentMutationExecution {
  id                     String                  @id @default(cuid())
  grantId                String                  @unique(map: "agent_mutation_execution_grant_id_key")
  grant                  AgentActionGrant        @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_execution_grant_id_fkey")
  runId                  String
  sessionId              String                  @db.VarChar(64)
  generation             Int
  action                 String                  @db.VarChar(64)
  adapterPrincipalId     String                  @db.VarChar(128)
  adapterRuntimeIdentity String                  @db.VarChar(191)
  bindingDigest          String                  @db.Char(64)
  status                 String                  @db.VarChar(32)
  readbackObservationId  String?                 @db.VarChar(191)
  pullRequestNumber      Int?
  pullRequestNodeId      String?                 @db.VarChar(191)
  pullRequestUrl         String?                 @db.VarChar(2048)
  pullRequestHeadRef     String?                 @db.VarChar(255)
  pullRequestHeadSha     String?                 @db.Char(40)
  pullRequestBaseSha     String?                 @db.Char(40)
  pullRequestMarker      String?                 @db.VarChar(191)
  closesClaimedIssue     Boolean?
  resultDigest           String?                 @db.Char(64)
  startedAt              DateTime                @default(now()) @db.DateTime(3)
  verifiedAt             DateTime?               @db.DateTime(3)
  createdAt              DateTime                @default(now()) @db.DateTime(3)
  updatedAt              DateTime                @updatedAt
  readbacks              AgentMutationReadback[]
  steps                  AgentMutationStep[]

  @@index([runId, generation, status], map: "agent_mutation_execution_run_gen_status_idx")
  @@index([sessionId, status], map: "agent_mutation_execution_session_status_idx")
  @@map("agent_mutation_execution")
}

// READY_PR mutation은 외부에 보이는 순서대로 CREATE_COMMIT -> CREATE_REF ->
// CREATE_PR 세 단계만 허용한다. 각 단계의 generation과 status는 provider write와
// 별도로 영속화되어 runtime 강제 종료 뒤에도 readback부터 재개할 수 있다.
model AgentMutationStep {
  id                 String                     @id @default(cuid())
  executionId        String
  execution          AgentMutationExecution     @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_step_execution_id_fkey")
  kind               String                     @db.VarChar(32)
  ordinal            Int
  status             String                     @default("PENDING") @db.VarChar(32)
  generation         Int                        @default(0)
  inputDigest        String?                    @db.Char(64)
  expectedTreeSha    String?                    @db.Char(40)
  expectedCommitSha  String?                    @db.Char(40)
  outputSha          String?                    @db.Char(40)
  outputNumber       Int?
  outputNodeId       String?                    @db.VarChar(191)
  outputUrl          String?                    @db.VarChar(2048)
  lastReadbackDigest String?                    @db.Char(64)
  claimExpiresAt     DateTime?                  @db.DateTime(3)
  verifiedAt         DateTime?                  @db.DateTime(3)
  createdAt          DateTime                   @default(now()) @db.DateTime(3)
  updatedAt          DateTime                   @updatedAt
  attempts           AgentMutationStepAttempt[]

  @@unique([executionId, kind], map: "agent_mutation_step_execution_kind_key")
  @@unique([executionId, ordinal], map: "agent_mutation_step_execution_ordinal_key")
  @@index([status, claimExpiresAt], map: "agent_mutation_step_status_expiry_idx")
  @@map("agent_mutation_step")
}

// requestId는 HTTP 재전송 멱등키이고 generation은 해당 step의 CAS 세대다.
// claim/plan/completion은 같은 session, runtime fingerprint, adapter identity에
// 묶이며 capability나 provider token을 저장하지 않는다.
model AgentMutationStepAttempt {
  id                     String             @id @default(cuid())
  stepId                 String
  step                   AgentMutationStep  @relation(fields: [stepId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_step_attempt_step_id_fkey")
  sessionId              String             @db.VarChar(64)
  session                AgentWorkerSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_step_attempt_session_id_fkey")
  generation             Int
  principalId            String             @db.VarChar(128)
  runtimeBindingDigest   String             @db.Char(64)
  adapterPrincipalId     String             @db.VarChar(128)
  adapterRuntimeIdentity String             @db.VarChar(191)
  requestId              String             @unique(map: "agent_mutation_step_attempt_request_id_key") @db.VarChar(191)
  bindingDigest          String             @db.Char(64)
  status                 String             @default("CLAIMED") @db.VarChar(32)
  expiresAt              DateTime           @db.DateTime(3)
  planRequestId          String?            @unique(map: "agent_mutation_step_attempt_plan_request_id_key") @db.VarChar(191)
  planDigest             String?            @db.Char(64)
  completionRequestId    String?            @unique(map: "agent_mutation_step_attempt_completion_request_id_key") @db.VarChar(191)
  completionDigest       String?            @db.Char(64)
  completedAt            DateTime?          @db.DateTime(3)
  createdAt              DateTime           @default(now()) @db.DateTime(3)

  @@unique([stepId, generation], map: "agent_mutation_step_attempt_generation_key")
  @@index([sessionId, expiresAt], map: "agent_mutation_step_attempt_session_expiry_idx")
  @@index([status, expiresAt], map: "agent_mutation_step_attempt_status_expiry_idx")
  @@map("agent_mutation_step_attempt")
}

model AgentMutationReadback {
  id                     String                 @id @default(cuid())
  executionId            String
  execution              AgentMutationExecution @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_readback_execution_id_fkey")
  observationId          String                 @unique(map: "agent_mutation_readback_observation_id_key")
  observation            AgentGithubObservation @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "agent_mutation_readback_observation_id_fkey")
  adapterPrincipalId     String                 @db.VarChar(128)
  adapterRuntimeIdentity String                 @db.VarChar(191)
  status                 String                 @db.VarChar(32)
  resultDigest           String                 @db.Char(64)
  requestId              String                 @unique(map: "agent_mutation_readback_request_id_key") @db.VarChar(191)
  createdAt              DateTime               @default(now()) @db.DateTime(3)

  @@index([executionId, createdAt], map: "agent_mutation_readback_execution_created_idx")
  @@map("agent_mutation_readback")
}

model AgentRunEvent {
  id         String   @id @default(cuid())
  requestId  String?  @unique
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type       String
  generation Int?
  actor      String
  payload    Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([runId, createdAt])
  @@map("agent_run_event")
}

// GitHub webhook 수신과 automation enqueue를 분리하는 durable inbox.
// webhook handler 실패나 재전송과 무관하게 scheduler가 동일 sourceKey를 한 번만 소진한다.
model AutomationIngressEvent {
  id           String    @id @default(cuid())
  sourceKey    String    @unique
  event        String
  action       String?
  repoFullName String
  issueNumber  Int?
  issueNodeId  String?
  payload      Json?
  payloadHash  String?   @db.Char(64)
  occurredAt   DateTime  @db.DateTime(3)
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  eligibleAt   DateTime  @default(now()) @db.DateTime(3)
  processedAt  DateTime? @db.DateTime(3)
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt

  @@index([status, eligibleAt])
  @@index([repoFullName, issueNumber])
  @@map("automation_ingress_event")
}

// 운영 명령의 Idempotency-Key를 actor/operation/target/request hash에 고정한다.
// PENDING row는 crash 후 동일 요청의 안전한 재실행을 허용하고, COMPLETED response는
// side effect를 다시 만들지 않고 그대로 재생한다.
model AutomationMutationRequest {
  requestId   String    @id
  actor       String
  operation   String
  targetKey   String
  requestHash String    @db.Char(64)
  status      String    @default("PENDING")
  request     Json
  response    Json?
  completedAt DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt

  @@index([status, updatedAt])
  @@map("automation_mutation_request")
}

enum FleetProjectBindingStatus {
  PENDING
  VERIFIED
  HUMAN_PERMISSION_REQUIRED
  READBACK_REQUIRED
  IDENTITY_MISMATCH
}

// 조직 전체가 공유하는 단 하나의 GitHub ProjectV2 desired-state binding.
// 앱별 project ID를 복제하지 않고 공개 owner/number/title/node identity와
// GitHub App organization_projects permission readback만 보존한다.
model FleetProjectBinding {
  id                    String                    @id @db.VarChar(64)
  organizationLogin     String                    @db.VarChar(39)
  projectNumber         Int
  expectedTitle         String                    @db.VarChar(191)
  revision              Int                       @default(1)
  projectNodeId         String?                   @db.VarChar(191)
  observedProjectNodeId String?                   @db.VarChar(191)
  organizationNodeId    String?                   @db.VarChar(191)
  observedTitle         String?                   @db.VarChar(191)
  observedUrl           String?                   @db.VarChar(2048)
  permissionLevel       String?                   @db.VarChar(16)
  missingRequirements   Json?
  status                FleetProjectBindingStatus @default(PENDING)
  lastErrorCode         String?                   @db.VarChar(96)
  lastError             String?                   @db.Text
  observedAt            DateTime?                 @db.DateTime(3)
  verifiedAt            DateTime?                 @db.DateTime(3)
  createdBy             String                    @db.VarChar(128)
  updatedBy             String                    @db.VarChar(128)
  createdAt             DateTime                  @default(now()) @db.DateTime(3)
  updatedAt             DateTime                  @updatedAt

  @@index([status, updatedAt])
  @@map("fleet_project_binding")
}

// GitHub Project는 포트폴리오 projection일 뿐 실행 claim의 입력이 아니다.
// desired/observed를 따로 보존해 permission 부재나 drift를 UI에서 fail-closed로 보인다.
model FleetProjectProjection {
  id              String    @id @default(cuid())
  appId           String?
  app             App?      @relation(fields: [appId], references: [id], onDelete: SetNull)
  projectNodeId   String
  bindingRevision Int?
  issueNodeId     String
  repoFullName    String
  issueNumber     Int
  desired         Json
  desiredHash     String    @db.Char(64)
  observed        Json?
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  lastError       String?   @db.Text
  appliedAt       DateTime? @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt

  @@unique([projectNodeId, issueNodeId])
  @@index([appId, status])
  @@index([status, updatedAt])
  @@map("fleet_project_projection")
}

// ──────────────────────────────────────────────────────────────────────────
// Vault RAG — Obsidian 지식 볼트(Syncthing) 임베딩 인덱스 + 쓰기 큐
// indexer(data ns)가 PVC 를 읽어 채우고, backoffice(platform ns)는 MySQL 로만 조회.
// 벡터는 ANN 인덱스(HeatWave 전용) 없이 float32 BLOB 로 저장 → 앱에서 brute-force cosine.
// ──────────────────────────────────────────────────────────────────────────
model VaultChunk {
  id        String   @id @default(cuid())
  path      String // 볼트 기준 상대경로, e.g. "프로젝트/앱 제작 공장/11 백오피스.md"
  ord       Int // 파일 내 청크 순서
  heading   String?  @db.Text // 가장 가까운 헤딩 breadcrumb
  text      String   @db.Text
  fileHash  String // 파일 전체 sha256 (증분 인덱싱 판정)
  embedding Bytes // float32 LE 패킹
  dim       Int
  chars     Int      @default(0)
  indexedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([path, ord])
  @@index([fileHash])
  @@index([indexedAt])
  @@map("vault_chunk")
}

model VaultWriteRequest {
  id          String           @id @default(cuid())
  folder      String           @default("받은함") // 대상 하위폴더(allowlist 강제)
  filename    String // 확장자 제외 제목(슬러그화)
  content     String           @db.Text
  source      String           @default("agent") // agent|discord|web
  requestedBy String?
  status      VaultWriteStatus @default(PENDING)
  writtenPath String? // 실제 기록된 상대경로
  error       String?          @db.Text
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  processedAt DateTime?        @db.DateTime(3)

  @@index([status])
  @@map("vault_write_request")
}

enum VaultWriteStatus {
  PENDING
  DONE
  FAILED
}

/// 플랫폼 전체 사용자 규모의 시점 스냅샷.
///
/// 앱별 지표(AppMetricDaily)와 달리 앱을 가로지르는 플랫폼 전체 값이라
/// appId가 없다. 매시 정각에 platform Admin API를 찍어 저장한다.
///
/// 백필이 불가능하다. platform의 lastSeenAt은 덮어쓰기라 과거 시점의
/// 활성 사용자 수를 복원할 수 없다. 이 표는 수집을 시작한 시점부터만
/// 존재하고, cron이 실패한 구간은 영구히 빈다.
model PlatformUserMetricSample {
  id String @id @default(cuid())

  /// 서버가 집계 기준으로 삼은 시각을 정시로 내림한 값.
  /// 재실행해도 같은 시각이면 덮어쓰도록 유니크로 둔다.
  capturedAt DateTime @unique @db.DateTime(3)

  totalUsers        Int @default(0)
  /// 직전 1시간 활성. 창이 겹치지 않아 시간대별 굴곡이 남는다.
  hourlyActiveUsers Int @default(0)
  /// 직전 24시간 롤링. 이웃한 시간 샘플과 창을 23/24 공유한다.
  dailyActiveUsers  Int @default(0)
  weeklyActiveUsers Int @default(0)

  /// 활성 판정 근거. platform이 정의를 바꾸면 여기서 드러나야 한다.
  activitySource String @default("session_last_seen")

  collectedAt DateTime @default(now()) @db.DateTime(3)

  @@index([capturedAt])
  @@map("platform_user_metric_sample")
}

/// RPI Presence Edge가 갱신하는 최근 활성 세션 projection.
///
/// 결제·사용자 원장이 아니며 유실을 허용하는 운영 관측값이다. Edge가 서버
/// 시각으로 expiresAt을 갱신하고, Backoffice는 아직 만료되지 않은 행만 센다.
model PlatformPresenceSession {
  appId       String @map("app_id") @db.VarChar(64)
  sessionHash String @map("session_hash") @db.Char(64)

  platform     String @db.VarChar(16)
  appVersion   String @default("") @map("app_version") @db.VarChar(32)
  lastSequence BigInt @default(0) @map("last_sequence")

  lastSeenAt DateTime @map("last_seen_at") @db.DateTime(3)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([appId, sessionHash])
  @@index([expiresAt])
  @@index([appId, expiresAt])
  @@map("platform_presence_session")
}

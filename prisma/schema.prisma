// secret 값이 아닌 logical credential과 공개 identity만 저장한다.
// 실제 값의 조회·변경·export API는 이 데이터 모델과 Backoffice UI에 존재하지 않는다.
model CredentialBinding {
  id                     String                  @id @default(cuid())
  appId                  String
  app                    App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  logicalCredentialId    String
  provider               String
  capability             String
  environment            String
  publicIdentity         String?
  fingerprint            String?
  consumer               String
  scope                  Json?
  status                 CredentialBindingStatus @default(ACTIVE)
  credentialGeneration   Int?
  policyGeneration       Int?
  adapterId              String?                 @db.VarChar(64)
  origin                 String?                 @db.VarChar(512)
  authFactors            Json?
  observedAt             DateTime                @db.DateTime(3)
  // catalog의 검증된 공개 projection을 optimistic concurrency로 갱신한다.
  // 기존 row는 nullable provenance로 남겨 자동 승격하지 않고 다음 검증 import가 채운다.
  revision               Int?
  catalogEntryDigest     String?                 @db.Char(64)
  catalogSnapshotDigest  String?                 @db.Char(64)
  catalogContractVersion String?                 @db.VarChar(64)
  observedBy             String?                 @db.VarChar(128)
  createdAt              DateTime                @default(now()) @db.DateTime(3)
  updatedAt              DateTime                @updatedAt

  @@unique([appId, logicalCredentialId, capability])
  @@index([appId, provider, status])
  @@index([appId, status, revision], map: "cp_credential_binding_app_status_revision_idx")
  @@map("control_plane_credential_binding")
}

enum CredentialBindingStatus {

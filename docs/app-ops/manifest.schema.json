{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/seorilabs/seorilabs-backoffice/main/docs/app-ops/manifest.schema.json",
  "title": "Seorilabs App Backoffice Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tools": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/tool" }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/$defs/content" }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "analyticsIdent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "op"],
      "properties": {
        "param": { "$ref": "#/$defs/analyticsIdent" },
        "op": {
          "enum": ["eq", "ne", "ne_or_unset", "gt", "gte", "lt", "lte", "truthy"]
        },
        "value": { "type": ["string", "number"] }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "event", "agg"],
      "properties": {
        "key": { "$ref": "#/$defs/analyticsIdent" },
        "label": { "$ref": "#/$defs/label" },
        "event": {
          "oneOf": [
            { "$ref": "#/$defs/analyticsIdent" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/analyticsIdent" }
            }
          ]
        },
        "agg": { "enum": ["count", "users", "sum", "avg"] },
        "param": { "$ref": "#/$defs/analyticsIdent" },
        "where": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/predicate" }
        },
        "unit": { "type": "string", "maxLength": 16 },
        "round": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "agg": { "enum": ["sum", "avg"] } },
            "required": ["agg"]
          },
          "then": { "required": ["param"] }
        }
      ]
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "num", "den"],
      "properties": {
        "key": { "$ref": "#/$defs/analyticsIdent" },
        "label": { "$ref": "#/$defs/label" },
        "num": { "$ref": "#/$defs/analyticsIdent" },
        "den": { "$ref": "#/$defs/analyticsIdent" },
        "scale": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "round": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "event", "param"],
      "properties": {
        "key": { "$ref": "#/$defs/analyticsIdent" },
        "label": { "$ref": "#/$defs/label" },
        "event": { "$ref": "#/$defs/analyticsIdent" },
        "param": { "$ref": "#/$defs/analyticsIdent" },
        "topN": { "type": "integer", "minimum": 1, "maximum": 100 },
        "valueLabels": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 80 }
        },
        "where": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/predicate" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {
          "allOf": [
            { "$ref": "#/$defs/ident" },
            {
              "not": {
                "pattern": "([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Rr][Ee][Cc][Ee][Ii][Pp][Tt]|[Pp][Uu][Rr][Cc][Hh][Aa][Ss][Ee][_-]?[Tt][Oo][Kk][Ee][Nn]|[Ss][Ii][Gg][Nn][Ee][Dd][_-]?([Dd][Aa][Tt][Aa]|[Pp][Aa][Yy][Ll][Oo][Aa][Dd])|[Ii][Dd][_-]?[Tt][Oo][Kk][Ee][Nn]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn])"
              }
            }
          ]
        },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["text", "number", "boolean", "select", "textarea"] },
        "required": { "type": "boolean", "default": true },
        "placeholder": { "type": "string", "maxLength": 120 },
        "help": { "type": "string", "maxLength": 240 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "maxLength": 80 },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "select" } },
            "required": ["type"]
          },
          "then": { "required": ["options"] }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "intent"],
      "properties": {
        "id": { "$ref": "#/$defs/ident" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "intent": { "enum": ["read", "mutate"] },
        "risk": { "enum": ["low", "medium", "high"], "default": "low" },
        "confirmation": {
          "enum": ["none", "reason", "typed"],
          "default": "none"
        },
        "inputs": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/input" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "intent": { "const": "mutate" } },
            "required": ["intent"]
          },
          "then": {
            "required": ["confirmation"],
            "properties": {
              "confirmation": { "enum": ["reason", "typed"] }
            }
          }
        },
        {
          "if": {
            "properties": { "risk": { "const": "high" } },
            "required": ["risk"]
          },
          "then": {
            "required": ["confirmation"],
            "properties": {
              "confirmation": { "const": "typed" }
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/ident" },
        "section": {
          "enum": ["operations", "commerce", "ads", "content", "flags"]
        },
        "title": { "$ref": "#/$defs/label" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "runbook": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(docs/|README\\.md$)"
        },
        "operations": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "param": { "$ref": "#/$defs/analyticsIdent" },
            "platformMap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "android": { "$ref": "#/$defs/ident" },
                "ios": { "$ref": "#/$defs/ident" },
                "web": { "$ref": "#/$defs/ident" }
              }
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": { "$ref": "#/$defs/ident" },
                  "label": { "$ref": "#/$defs/label" }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/metric" }
        },
        "distributions": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/distribution" }
        },
        "groups": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "param", "metrics"],
            "properties": {
              "key": { "$ref": "#/$defs/analyticsIdent" },
              "label": { "$ref": "#/$defs/label" },
              "param": { "$ref": "#/$defs/analyticsIdent" },
              "metrics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": { "$ref": "#/$defs/metric" }
              },
              "derived": {
                "type": "array",
                "maxItems": 20,
                "items": { "$ref": "#/$defs/derived" }
              },
              "valueLabels": {
                "type": "object",
                "additionalProperties": { "type": "string", "maxLength": 80 }
              },
              "topN": { "type": "integer", "minimum": 1, "maximum": 100 },
              "orderBy": { "$ref": "#/$defs/analyticsIdent" },
              "order": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "maxLength": 80 }
              },
              "render": { "enum": ["table", "funnel"] }
            }
          }
        },
        "derived": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/derived" }
        }
      }
    }
  }
}

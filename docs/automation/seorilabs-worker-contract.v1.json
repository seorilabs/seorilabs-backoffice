{
  "schemaVersion": 1,
  "workerInstallations": [
    {
      "key": "seorilabs-codex-generic-worker",
      "agentKind": "CODEX",
      "principalId": "codex:seorilabs-generic-worker",
      "maximumActiveInstallations": 1,
      "promptFile": "codex-generic-worker.md"
    },
    {
      "key": "seorilabs-claude-generic-worker",
      "agentKind": "CLAUDE",
      "principalId": "claude:seorilabs-generic-worker",
      "maximumActiveInstallations": 1,
      "promptFile": "claude-generic-worker.md"
    }
  ],
  "authentication": {
    "audience": "agent-worker",
    "principalCapabilities": {
      "codex:seorilabs-generic-worker": "AGENT_WORKER_CODEX_TOKEN",
      "claude:seorilabs-generic-worker": "AGENT_WORKER_CLAUDE_TOKEN"
    },
    "distinctCapabilitiesRequired": true,
    "legacySharedTokenAccepted": false,
    "mutationCapabilityBrokerRequiredForReadyPr": true,
    "requiredHeaders": [
      "Authorization: Bearer <capability bound to the declared principal>",
      "X-Seori-Principal: <matching stable worker id>",
      "Idempotency-Key: <unique operation id>"
    ],
    "forbidden": [
      "password",
      "totp",
      "cookie",
      "apiKey",
      "recoveryCode"
    ]
  },
  "endpoints": {
    "claim": "/api/internal/agents/claim",
    "heartbeat": "/api/internal/agents/heartbeat",
    "complete": "/api/internal/agents/complete",
    "fail": "/api/internal/agents/fail",
    "readbackRequired": "/api/internal/agents/readback-required",
    "readbackResolve": "/api/internal/agents/readback"
  },
  "claimPolicy": {
    "fields": [
      "approvalPolicy",
      "budgetCeilingMicros",
      "spentMicros",
      "remainingBudgetMicros",
      "actionCapabilities",
      "resumeMode",
      "model"
    ],
    "approvalPolicies": {
      "READY_PR": "지정 Issue의 Ready PR 한 건까지만 허용",
      "READ_ONLY": "GitHub와 provider readback만 허용하고 PR을 만들지 않음"
    },
    "routing": {
      "deterministic": "MicroK8S scheduler",
      "codeAndReview": "claim.agentKind subscription worker",
      "structuredApi": "eval-approved-lowest-cost-only"
    }
  },
  "resultPolicy": {
    "costMicrosRequiredOnEverySettlement": true,
    "budgetScope": "cumulative per AgentRun including readback",
    "readOnlyOutcomeCodes": [
      "NO_CHANGES",
      "READBACK_CONFIRMED",
      "RESULT_UNKNOWN",
      "BLOCKED"
    ],
    "readbackLease": "RESULT_UNKNOWN revokes the mutation lease; a later claim returns the same run with a new generation and READBACK_FIRST capability"
  },
  "invariants": [
    "claim이 null이면 아무 Issue나 PR도 만들지 않고 종료한다",
    "resumeMode가 READBACK_FIRST이면 새 generation lease로 같은 run의 GitHub/provider 상태만 먼저 조회한다",
    "repo마다 자율 PR은 동시에 하나만 존재할 수 있다",
    "approvalPolicy와 budgetCeilingMicros를 넘는 작업은 시작하지 않는다",
    "lease generation이 바뀌면 이전 completion을 제출하지 않는다",
    "외부 mutation 결과가 불명확하면 새 Issue나 PR을 만들지 않고 readbackRequired를 기록한다",
    "심사 제출, 공개 배포, 권한 또는 key 변경은 수행하지 않는다"
  ]
}

# ===== Database (data ns MySQL, 전용 backoffice DB) =====
# 로컬 개발: 포트포워딩 또는 NodePort(32306). 운영: 클러스터 내부 DNS.
DATABASE_URL="mysql://backoffice:CHANGEME@127.0.0.1:3306/backoffice?connection_limit=5"

# ===== Auth.js (NextAuth v5) =====
AUTH_SECRET="generate-with: openssl rand -base64 33"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# 신규 GitHub App 의 user-to-server OAuth client (로그인용)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===== GitHub App (미러/webhook/이슈 write 용) =====
GITHUB_ORG="seorilabs"
GITHUB_APP_ID=""
# Godot 버전 감지 알림 기준값. global-versions.yaml 의 tools.godot.version 미러링.
GODOT_PINNED_VERSION="4.6.3"
# PKCS8/PKCS1 PEM. 개행은 \n 으로 escape 하거나 그대로 멀티라인.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=""

# ===== Allowlist (보조; 1차는 User.allowlisted 테이블) =====
# 콤마구분 GitHub login. 비우면 org 멤버십만으로 판단.
ALLOWLIST_LOGINS="magicsih"

# ===== Gemini (Stage Agent + Vault 질의 임베딩) =====
# 운영에서는 Backoffice 전용 회사 키를 사용한다. Vault 배치 인덱서는 별도 키를 사용한다.
FEATURE_GEMINI_ENABLED="true"
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GEMINI_CHAT_TIMEOUT_MS="180000"
# 일일 병합 다이제스트 AI 한 줄 적용률(0~100). 확정적 PR 목록은 이 값과 무관하게 항상 발송.
DAILY_DIGEST_GEMINI_ROLLOUT_PERCENT="10"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_EMBED_MODEL="gemini-embedding-001"
GEMINI_EMBED_DIM="1536"
GEMINI_TIMEOUT_MS="60000"
# LLM 월 예산(USD). 0 = 미확정(운영 총괄 리포트에 보고만, 경고 없음).
LLM_MONTHLY_BUDGET_USD="0"
# P1·P2 자동 등록 상한(실행당=일일)과 NOT_PLANNED 비율 기준(%) — 초과 시 수동 복귀.
TEAMMATE_AUTO_DAILY_LIMIT="2"
TEAMMATE_AUTO_NOT_PLANNED_DISABLE_PCT="30"
# 페르소나별 모델 교차 배정(teammates.ts model 필드). 키 미설정 provider 는 Gemini 폴백.
FEATURE_MULTI_LLM="false"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ===== Sync =====
RECONCILE_INTERVAL_MS="21600000"
# 부팅 시 reconcile 스케줄러 비활성화(테스트용)
# DISABLE_SCHEDULER="false"

# ===== Admin (헤드리스 시드 트리거 /api/admin/seed) =====
INTERNAL_ADMIN_TOKEN=""
# Fleet Control Plane write/read. 미설정 시 기존 INTERNAL_ADMIN_TOKEN으로만 호환한다.
CONTROL_PLANE_ADMIN_TOKEN=""
# agent claim/heartbeat/complete/fail 전용. Control Plane admin token과 분리한다.
AGENT_WORKER_TOKEN=""
# worker에 주입하지 않는 server-side lease capability HMAC 키.
AGENT_LEASE_SIGNING_KEY=""
# ACTIVE ConfigRevision 불변 snapshot HMAC. 미설정이면 activation은 fail-closed.
CONTROL_PLANE_SNAPSHOT_SIGNING_KEY=""

# ===== GA4 → BigQuery 지표 =====
# ON + SA 키(JSON 전체) 있으면 수집(/api/admin/analytics/collect)·보고·(/analytics) 대시보드 활성.
# SA 키: ~/.config/seorilabs/ga4-routine-ro.json (lucid-chess/crossword-puzzle/happy-farm 읽기 권한).
# 로컬은 파일 내용을 한 줄로 붙여넣는다. 운영은 backoffice-secrets(SealedSecret)로 주입.
FEATURE_GA4_ANALYTICS="false"
GA4_SA_KEY_JSON=""
# GA4_BQ_LOCATION="US"   # export 데이터셋 리전(기본: dataset 메타에서 자동 조회)
# GA4_MAX_BYTES_BILLED="" # 수집 쿼리 스캔 상한(bytes, 기본 2GiB). 초과 job 은 실패시켜 과금 차단.

# ===== Seorilabs Platform Admin API =====
# 웹 서버에는 READ 키만, AppOps worker에는 WRITE 키만 설정한다.
# 두 SA 모두 Cloud Run run.invoker 외 프로젝트 권한을 주지 않는다.
FEATURE_PLATFORM_ADMIN="false"
# registry IAP·catalog·worker write identity 준비 뒤에만 true로 전환한다.
FEATURE_PLATFORM_ADMIN_WRITES="false"
PLATFORM_ADMIN_URL=""
PLATFORM_ADMIN_READ_SA_KEY_JSON=""
# 로컬에서 worker를 실행할 때만 사용. 웹 서버 운영 Secret에는 넣지 않는다.
PLATFORM_ADMIN_WRITE_SA_KEY_JSON=""

# ===== Discord (인터랙티브 ChatOps + 알림) =====
# 네 값이 모두 있어야 interaction 검증과 Bot 전송이 활성화된다.
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""     # interaction Ed25519 서명 검증용
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# 알림 목적지 channel id. 값이 없는 목적지는 전달을 만들지 않는다.
DISCORD_CHANNEL_BACKOFFICE_ID=""
DISCORD_CHANNEL_METRICS_DAILY_ID=""
DISCORD_CHANNEL_ACTION_EVENTS_ID=""
DISCORD_CHANNEL_RELEASE_OPS_ID=""
DISCORD_CHANNEL_OPS_ALERTS_ID=""
DISCORD_CHANNEL_SEORI_REVIEW_ID=""
DISCORD_CHANNEL_PRIVATE_FEED_ID=""
DISCORD_CHANNEL_FINANCE_ALERTS_ID=""
DISCORD_CHANNEL_USER_REVIEWS_ID=""
# 담당제 AI 팀원 봇 (teammate worker). 오너 5명(노을/이슬/바람/새벽/마루) + 운영 총괄(서리).
# 플래그 on + 팀원별 앱ID/토큰 둘 다 있어야 해당 팀원 활성.
# 비용 순찰 소스 3키는 optional — 미설정 소스는 리포트에 "미설정" 으로 표기된다.
FEATURE_DISCORD_TEAMMATES="false"
DISCORD_TEAMMATE_NOEUL_APPLICATION_ID=""
DISCORD_TEAMMATE_NOEUL_BOT_TOKEN=""
DISCORD_TEAMMATE_ISEUL_APPLICATION_ID=""
DISCORD_TEAMMATE_ISEUL_BOT_TOKEN=""
DISCORD_TEAMMATE_BARAM_APPLICATION_ID=""
DISCORD_TEAMMATE_BARAM_BOT_TOKEN=""
DISCORD_TEAMMATE_SAEBYEOK_APPLICATION_ID=""
DISCORD_TEAMMATE_SAEBYEOK_BOT_TOKEN=""
DISCORD_TEAMMATE_MARU_APPLICATION_ID=""
DISCORD_TEAMMATE_MARU_BOT_TOKEN=""
DISCORD_TEAMMATE_SEORI_APPLICATION_ID=""
DISCORD_TEAMMATE_SEORI_BOT_TOKEN=""
DISCORD_CHANNEL_APP_OPS_ID="" # 담당제 통합 운영 채널(순찰 보고·confirm 카드)
GITHUB_BILLING_TOKEN=""       # fine-grained PAT (Organization Administration read)
GCP_BILLING_EXPORT_TABLE=""   # project.dataset.table
STABILITY_API_KEY=""""
# 명령 권한 role id (roles.ts 의 ROLE_CAPABILITIES 키와 1:1). k8s/secret.example.yaml 참고.
DISCORD_ROLE_OPERATIONS_ADMIN_ID=""
DISCORD_ROLE_OPERATOR_ID=""
DISCORD_ROLE_PRODUCT_ID=""
DISCORD_ROLE_DESIGN_ID=""
DISCORD_ROLE_DEVELOPMENT_ID=""
DISCORD_ROLE_QA_ID=""
DISCORD_ROLE_DATA_ID=""
DISCORD_ROLE_RELEASE_OPS_ID=""
DISCORD_ROLE_CS_ID=""
DISCORD_ROLE_VIEWER_ID=""
DISCORD_RETENTION_DAYS="30"   # Bot 이 만든 종료 메시지 보존 일수

# ===== Xcode Cloud (iOS/App Store 배포) =====
# iOS 를 GitHub Actions(macOS 쿼타) 대신 Xcode Cloud 로 빌드/업로드하는 앱 목록.
# 여기 있는 repoFullName 은 App Store 배포 시 GH workflow_dispatch 가 아니라
# App Store Connect API 로 Xcode Cloud 빌드를 트리거한다. (CSV)
XCODE_CLOUD_APP_STORE_REPOS=""   # 예: "seorilabs/happy-farm"
# App Store Connect API 팀 키(위 앱이 있을 때만 필요)
APP_STORE_CONNECT_API_KEY_ID=""
APP_STORE_CONNECT_ISSUER_ID=""
APP_STORE_CONNECT_PRIVATE_KEY_BASE64=""   # .p8 PEM 의 base64
